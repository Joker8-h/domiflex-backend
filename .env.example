# DomiFlex Backend — variables de entorno
# Copiar a .env y completar. No versionar el .env real.

# Base de datos MySQL (nueva, separada de Moviflexx)
DATABASE_URL="mysql://usuario:password@localhost:3306/domiflex"

# JWT
JWT_SECRET="cambiar-por-secreto-propio"
JWT_EXPIRES_IN="7d"

# Google OAuth (opcional, crear credenciales propias)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudinary (cuenta propia para fotos de repartidor/productos)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optimización de rutas. Si OPTIMIZER_URL está vacío, el precio usa OSRM y luego Haversine.
OSRM_BASE_URL="https://domiflex-osrm-production.up.railway.app"
OPTIMIZER_URL="https://route-optimizer-production-7e60.up.railway.app"
FUEL_L_PER_100KM="7.5"
FUEL_PRICE_PER_LITER="15000"

# Web pública (correos y reset de contraseña)
FRONTEND_URL="https://domiflex-web-production.up.railway.app"

# Microservicios IA. Placas acepta IA_PLACA_URL o AI_PLATE_URL.
IA_PLACA_URL=""
IA_FACIAL_URL="https://domiflex-facial-production.up.railway.app"
IA_OBJETOS_URL=""

# Email (Brevo/Sendinblue)
BREVO_API_KEY=""

PORT="3000"
NODE_ENV="development"
