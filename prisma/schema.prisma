generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/**
 * =======================
 * ENUMS — DomiFlex (domicilios)
 * El cliente crea el pedido, paga en efectivo,
 * la comisión de plataforma depende de la distancia.
 * =======================
 */

enum EstadoUsuario {
  ACTIVO
  INACTIVO
  SUSPENDIDO
}

enum EstadoConversacion {
  ACTIVA
  CERRADA
}

enum TipoMensaje {
  TEXTO
  SISTEMA
}

enum TipoPago {
  PEDIDO
  PLAN_REPARTIDOR
  EFECTIVO
  TRANSFERENCIA
}

enum EstadoPago {
  PENDIENTE
  PAGADO
  FALLIDO
  CONFIRMADO_CLIENTE
  CONFIRMADO_REPARTIDOR
  COMPLETADO
}

enum TipoParada {
  RECOGIDA
  ENTREGA
  AMBAS
}

enum TipoVehiculo {
  MOTO
  BICICLETA
  CARRO
  FURGON
}

enum TipoPlan {
  SEMANAL
  MENSUAL
  POR_PEDIDO
}

enum EstadoRuta {
  BORRADOR
  DISPONIBLE
  ARCHIVADA
}

enum EstadoSuscripcion {
  ACTIVA
  VENCIDA
  CANCELADA
}

enum EstadoPedido {
  CREADO
  ASIGNADO
  RECOGIENDO
  EN_CAMINO
  ENTREGADO
  CANCELADO
}

enum EstadoVehiculo {
  ACTIVO
  INACTIVO
}

enum EstadoDocumentacion {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum EstadoSolicitudCambio {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum EstadoReportePago {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum TipoNegocio {
  COMIDA
  FARMACIA
  SUPERMERCADO
  TIENDA
  PAQUETERIA
  OTRO
}

/**
 * =======================
 * MODELOS
 * =======================
 */

model Roles {
  idRol  Int    @id @default(autoincrement())
  nombre String @unique @db.VarChar(50)

  usuarios Usuarios[]
}

model Usuarios {
  idUsuarios   Int           @id @default(autoincrement())
  idRol        Int
  nombre       String        @db.VarChar(100)
  email        String        @unique @db.VarChar(150)
  telefono     String?       @db.VarChar(20)
  passwordHash String        @db.VarChar(255)
  fotoPerfil   String?       @db.VarChar(500)
  fcmToken     String?       @db.VarChar(512)
  estado       EstadoUsuario @default(ACTIVO)
  creadoEn     DateTime      @default(now())

  rol Roles @relation(fields: [idRol], references: [idRol])

  vehiculos      Vehiculos[]
  pagos          Pagos[]
  mensajes       Mensajes[]
  suscripciones  SuscripcionesRepartidor[]
  notificaciones Notificacion[]
  sesiones       SesionesUsuario[]

  pedidosCliente    Pedidos[] @relation("PedidoCliente")
  pedidosRepartidor Pedidos[] @relation("PedidoRepartidor")
  pedidosComercio   Pedidos[] @relation("PedidoComercio")

  negocios Negocios[]

  calificacionesDadas     Calificaciones[] @relation("Calificador")
  calificacionesRecibidas Calificaciones[] @relation("Calificado")

  conversacionesCliente    Conversaciones[] @relation("ConversacionCliente")
  conversacionesRepartidor Conversaciones[] @relation("ConversacionRepartidor")

  documentacion Documentacion?
  reportesPago  ReportesPago[]

  // Campos para verificación OTP
  otpCode         String?   @db.VarChar(6)
  otpExpiry       DateTime?
  isEmailVerified Boolean   @default(false)
  googleId        String?   @unique @db.VarChar(255)

  // Campos para recuperación de contraseña
  resetToken       String?   @db.VarChar(255)
  resetTokenExpiry DateTime?

  // Datos de contacto de emergencia
  nombreEmergencia String? @db.VarChar(100)
  numeroEmergencia String? @db.VarChar(20)

  @@map("Usuarios")
}

model Vehiculos {
  idVehiculos Int @id @default(autoincrement())
  idUsuario   Int

  marca     String?        @db.VarChar(50)
  modelo    String?        @db.VarChar(50)
  placa     String?        @unique @db.VarChar(20)
  tipo      TipoVehiculo   @default(MOTO)
  // Capacidad de carga en kg (domicilios)
  capacidad Int
  estado    EstadoVehiculo @default(ACTIVO)

  // Foto para validación de la placa (IA)
  fotoPlaca     String? @db.VarChar(500)
  // Fotos generales del vehículo
  fotoAuto1     String? @db.VarChar(500)
  fotoAuto2     String? @db.VarChar(500)
  fotoAuto3     String? @db.VarChar(500)
  placaValidada Boolean @default(false)

  usuario Usuarios  @relation(fields: [idUsuario], references: [idUsuarios])
  pedidos Pedidos[]

  solicitudes SolicitudCambioVehiculo[]
}

model Rutas {
  idRuta      Int     @id @default(autoincrement())
  nombre      String? @db.VarChar(100)
  descripcion String? @db.VarChar(255)

  origen  String     @default("IA")
  estado  EstadoRuta @default(BORRADOR)
  scoreIa Decimal?   @db.Decimal(5, 2)

  creadoEn DateTime @default(now())

  paradas Paradas[]
  pedidos Pedidos[]
  iaLogs  IaRutasLog[]
}

model Paradas {
  idParada Int @id @default(autoincrement())
  idRuta   Int

  nombre      String?    @db.VarChar(100)
  lat         Decimal?   @db.Decimal(10, 8)
  lng         Decimal?   @db.Decimal(11, 8)
  orden       Int
  kmAcumulado Decimal?   @db.Decimal(10, 2)
  tipo        TipoParada @default(AMBAS)

  ruta Rutas @relation(fields: [idRuta], references: [idRuta])

  pedidoParadas PedidoParadas[]
}

model Pedidos {
  idPedido     Int  @id @default(autoincrement())
  idCliente    Int
  idRepartidor Int?
  idComercio   Int?
  idRuta       Int?
  idVehiculo   Int?
  negocioId    Int?

  // Punto de recogida (comercio / origen)
  nombreRecogida String?  @db.VarChar(255)
  dirRecogida    String?  @db.VarChar(255)
  latRecogida    Decimal? @db.Decimal(10, 8)
  lngRecogida    Decimal? @db.Decimal(11, 8)

  // Punto de entrega (cliente / destino)
  nombreEntrega String?  @db.VarChar(255)
  dirEntrega    String?  @db.VarChar(255)
  latEntrega    Decimal? @db.Decimal(10, 8)
  lngEntrega    Decimal? @db.Decimal(11, 8)

  detallePedido String? @db.VarChar(500)

  distanciaKm        Decimal? @db.Decimal(10, 2)
  subtotal           Decimal? @db.Decimal(10, 2)
  comisionPlataforma Decimal? @db.Decimal(10, 2)
  total              Decimal? @db.Decimal(10, 2)

  tipoPago TipoPago     @default(EFECTIVO)
  estado   EstadoPedido @default(CREADO)
  creadoEn DateTime     @default(now())

  cliente    Usuarios   @relation("PedidoCliente", fields: [idCliente], references: [idUsuarios])
  repartidor Usuarios?  @relation("PedidoRepartidor", fields: [idRepartidor], references: [idUsuarios])
  comercio   Usuarios?  @relation("PedidoComercio", fields: [idComercio], references: [idUsuarios])
  ruta       Rutas?     @relation(fields: [idRuta], references: [idRuta])
  vehiculo   Vehiculos? @relation(fields: [idVehiculo], references: [idVehiculos])
  negocio    Negocios?  @relation(fields: [negocioId], references: [id])

  paradas        PedidoParadas[]
  calificaciones Calificaciones[]
  conversaciones Conversaciones[]
  pagos          Pagos[]
  items          PedidoItem[]

  @@map("Pedidos")
}

model PedidoParadas {
  idPedido Int
  idParada Int

  orden      Int
  tipo       TipoParada @default(ENTREGA)
  completada Boolean    @default(false)

  pedido Pedidos @relation(fields: [idPedido], references: [idPedido])
  parada Paradas @relation(fields: [idParada], references: [idParada])

  @@id([idPedido, idParada])
  @@map("PedidoParadas")
}

model Calificaciones {
  idCalificacion Int @id @default(autoincrement())
  idPedido       Int
  idCalificador  Int
  idCalificado   Int

  puntuacion Int
  comentario String?

  creadoEn DateTime @default(now())

  pedido      Pedidos  @relation(fields: [idPedido], references: [idPedido])
  calificador Usuarios @relation("Calificador", fields: [idCalificador], references: [idUsuarios])
  calificado  Usuarios @relation("Calificado", fields: [idCalificado], references: [idUsuarios])
}

model Conversaciones {
  idConversacion Int @id @default(autoincrement())
  idPedido       Int
  idCliente      Int
  idRepartidor   Int

  fechaCreacion DateTime           @default(now())
  estado        EstadoConversacion

  pedido     Pedidos  @relation(fields: [idPedido], references: [idPedido])
  cliente    Usuarios @relation("ConversacionCliente", fields: [idCliente], references: [idUsuarios])
  repartidor Usuarios @relation("ConversacionRepartidor", fields: [idRepartidor], references: [idUsuarios])

  mensajes Mensajes[]
}

model Mensajes {
  idMensaje      Int @id @default(autoincrement())
  idConversacion Int
  idRemitente    Int

  mensaje    String?
  tipo       TipoMensaje
  fechaEnvio DateTime    @default(now())
  leido      Boolean     @default(false)

  conversacion Conversaciones @relation(fields: [idConversacion], references: [idConversacion])
  remitente    Usuarios       @relation(fields: [idRemitente], references: [idUsuarios])
}

model Pagos {
  idPago                 Int        @id @default(autoincrement())
  idPedido               Int
  idUsuario              Int
  tipoPago               TipoPago
  monto                  Decimal?   @db.Decimal(10, 2)
  estado                 EstadoPago @default(PENDIENTE)
  confirmacionCliente    Boolean    @default(false)
  confirmacionRepartidor Boolean    @default(false)
  fechaPago              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  usuario Usuarios @relation(fields: [idUsuario], references: [idUsuarios])
  pedido  Pedidos  @relation(fields: [idPedido], references: [idPedido])

  @@unique([idPedido, idUsuario])
}

model PlanesRepartidor {
  idPlan      Int     @id @default(autoincrement())
  nombre      String? @db.VarChar(50)
  descripcion String? @db.VarChar(255)

  tipo               TipoPlan
  precio             Decimal? @db.Decimal(10, 2)
  maxPedidos         Int?
  porcentajeComision Decimal? @db.Decimal(5, 2)
  activo             Boolean  @default(true)

  suscripciones SuscripcionesRepartidor[]

  @@map("PlanesRepartidor")
}

model SuscripcionesRepartidor {
  idSuscripcion Int @id @default(autoincrement())
  idUsuario     Int
  idPlan        Int

  fechaInicio DateTime?
  fechaFin    DateTime?

  estado               EstadoSuscripcion @default(ACTIVA)
  renovacionAutomatica Boolean           @default(false)

  usuario Usuarios         @relation(fields: [idUsuario], references: [idUsuarios])
  plan    PlanesRepartidor @relation(fields: [idPlan], references: [idPlan])

  @@map("SuscripcionesRepartidor")
}

model IaRutasLog {
  id     Int @id @default(autoincrement())
  idRuta Int

  prompt          String?
  parametrosJson  Json?
  modeloIa        String?  @db.VarChar(100)
  fechaGeneracion DateTime @default(now())

  ruta Rutas @relation(fields: [idRuta], references: [idRuta])
}

model Documentacion {
  idDocumentacion Int @id @default(autoincrement())
  idUsuario       Int @unique

  tipoDocumento   String? @db.VarChar(50)
  numeroDocumento String? @db.VarChar(50)
  fechaExpedicion String? @db.VarChar(50)

  imagenFrontalUrl String? @db.VarChar(255)

  estado        EstadoDocumentacion @default(PENDIENTE)
  fechaSubida   DateTime            @default(now())
  observaciones String?             @db.VarChar(255)

  // Nuevo campo para guardar resultados del OCR
  datosOcr Json?

  usuario Usuarios @relation(fields: [idUsuario], references: [idUsuarios])
}

model Notificacion {
  idNotificacion Int      @id @default(autoincrement())
  idUsuario      Int
  titulo         String   @db.VarChar(100)
  mensaje        String   @db.Text
  leido          Boolean  @default(false)
  fechaCreacion  DateTime @default(now())
  tipo           String   @db.VarChar(50) // 'SISTEMA', 'PEDIDO', 'PAGO', 'MENSAJE'

  usuario Usuarios @relation(fields: [idUsuario], references: [idUsuarios])

  @@map("Notificaciones")
}

model SesionesUsuario {
  idSesion         Int       @id @default(autoincrement())
  idUsuario        Int
  inicio           DateTime  @default(now())
  fin              DateTime?
  duracionSegundos Int?

  usuario Usuarios @relation(fields: [idUsuario], references: [idUsuarios])

  @@map("SesionesUsuario")
}

model SolicitudCambioVehiculo {
  idSolicitud Int @id @default(autoincrement())
  idVehiculo  Int

  marcaNueva        String? @db.VarChar(50)
  modeloNuevo       String? @db.VarChar(50)
  placaNueva        String? @db.VarChar(20)
  capacidadNueva    Int?
  fotoPlacaNuevaUrl String? @db.VarChar(255)
  fotoAuto1NuevaUrl String? @db.VarChar(255)
  fotoAuto2NuevaUrl String? @db.VarChar(255)
  fotoAuto3NuevaUrl String? @db.VarChar(255)

  estado         EstadoSolicitudCambio @default(PENDIENTE)
  fechaSolicitud DateTime              @default(now())
  fechaRevision  DateTime?
  observaciones  String?               @db.VarChar(255)

  vehiculo Vehiculos @relation(fields: [idVehiculo], references: [idVehiculos])

  @@map("SolicitudesCambioVehiculo")
}

model EmailVerificacion {
  id         Int      @id @default(autoincrement())
  email      String   @unique @db.VarChar(150)
  otpCode    String   @db.VarChar(6)
  otpExpiry  DateTime
  verificado Boolean  @default(false)
  creadoEn   DateTime @default(now())

  @@map("EmailVerificaciones")
}

model ReportesPago {
  idReporte          Int               @id @default(autoincrement())
  idUsuario          Int
  mesCorrespondiente DateTime
  montoComision      Decimal           @db.Decimal(10, 2)
  fotoComprobante    String            @db.VarChar(500)
  cantidadEnviada    Decimal?          @db.Decimal(10, 2)
  estado             EstadoReportePago @default(PENDIENTE)
  fechaEnvio         DateTime          @default(now())
  fechaRevision      DateTime?
  observaciones      String?           @db.VarChar(255)

  usuario Usuarios @relation(fields: [idUsuario], references: [idUsuarios])

  @@map("ReportesPago")
}

model CategoriasNegocio {
  id     Int     @id @default(autoincrement())
  nombre String  @unique @db.VarChar(100)
  icono  String? @db.VarChar(10)
  activo Boolean @default(true)

  negocios Negocios[]
}

model Negocios {
  id                  Int         @id @default(autoincrement())
  nombre              String      @db.VarChar(150)
  descripcion         String?     @db.VarChar(500)
  tipo                TipoNegocio @default(COMIDA)
  direccion           String      @db.VarChar(255)
  latitud             Decimal     @db.Decimal(10, 8)
  longitud            Decimal     @db.Decimal(11, 8)
  telefono            String?     @db.VarChar(20)
  imagen              String?     @db.VarChar(500)
  banner              String?     @db.VarChar(500)
  calificacion        Decimal     @default(0) @db.Decimal(3, 2)
  totalCalificaciones Int         @default(0)
  tiempoEstimadoMin   Int         @default(15)
  costoEnvio          Int         @default(2000)
  envioMinimo         Int         @default(0)
  activo              Boolean     @default(true)

  owner       Usuarios           @relation(fields: [ownerId], references: [idUsuarios])
  ownerId     Int
  categoriaId Int?
  categoria   CategoriasNegocio? @relation(fields: [categoriaId], references: [id])

  productos Producto[]
  pedidos   Pedidos[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Negocios")
}

model Producto {
  id          Int     @id @default(autoincrement())
  nombre      String  @db.VarChar(150)
  descripcion String? @db.VarChar(500)
  precio      Int
  imagen      String? @db.VarChar(500)
  categoria   String  @db.VarChar(100)
  disponible  Boolean @default(true)

  restaurante   Negocios @relation(fields: [restauranteId], references: [id])
  restauranteId Int

  pedidoItems PedidoItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Producto")
}

model PedidoItem {
  id       Int @id @default(autoincrement())
  cantidad Int @default(1)
  precio   Int

  pedido     Pedidos  @relation(fields: [pedidoId], references: [idPedido])
  pedidoId   Int
  menuItem   Producto @relation(fields: [menuItemId], references: [id])
  menuItemId Int

  @@map("PedidoItem")
}
